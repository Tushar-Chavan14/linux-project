# Single source of truth for naming/versions. Rename the distro here.
DISTRO_NAME="hyprdev"
DISTRO_PRETTY="HyprDev"
FEDORA_VERSION="44"
COPR_OWNER="tushar1402"
COPR_PROJECT="hyprdev"

# Third-party repos the ISO enables (all ship freely redistributable packages).
COPRS=(
  "sdegler/hyprland"     # hyprland, hyprlock, hypridle, xdph, eww-git, nwg-look
  "atim/starship"
  "atim/lazygit"
  "lihaohong/yazi"
  "erikreider/swayosd"
  "tushar1402/hyprdev"   # this distro: dotfile/theme/welcome updates
)

# Fixed Fedora mirror for ISO builds (metalink sometimes picks very slow ones).
# Empty = use Fedora's metalink. Benchmark: curl -w '%{speed_download}' on a big RPM.
FEDORA_MIRROR="${FEDORA_MIRROR-https://dl.fedoraproject.org/pub/fedora/linux}"
