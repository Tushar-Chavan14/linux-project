#!/usr/bin/env bash
# Restore hyprdev default dotfiles for the current user.
# Existing files are backed up to ~/.config/hyprdev/backup-<timestamp>/.
set -euo pipefail
src=/usr/share/hyprdev/skel
[[ -d $src ]] || { echo "missing $src" >&2; exit 1; }
stamp=$(date +%Y%m%d-%H%M%S)
backup="$HOME/.config/hyprdev/backup-$stamp"

cd "$src"
while IFS= read -r -d '' f; do
  rel=${f#./}
  dest="$HOME/$rel"
  # Personal files: user.conf, weather location, wallpaper, Settings choices, display modes.
  if [[ -e $dest || -L $dest ]] && [[ $rel == */user.conf || $rel == */hyprdev/location || $rel == .config/hypr/wallpaper || $rel == .config/hypr/hyprdev-settings.conf || $rel == .config/hypr/monitors.conf ]]; then continue; fi
  if [[ -e $dest ]] && ! cmp -s "$f" "$dest"; then
    mkdir -p "$backup/$(dirname "$rel")"
    cp -a "$dest" "$backup/$rel"
  fi
  mkdir -p "$(dirname "$dest")"
  cp -a "$f" "$dest"
done < <(find . \( -type f -o -type l \) -print0)

[[ -d $backup ]] && echo "Backed up changed files to $backup"
echo "Defaults restored. Reload with: hyprctl reload"
