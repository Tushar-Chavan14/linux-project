#!/usr/bin/env python3
"""HyprDev Settings: GUI for the common desktop settings.

Writes:
  ~/.config/hyprdev/settings.json        what the user picked (source of truth)
  ~/.config/hypr/hyprdev-settings.conf   Hyprland options generated from it
  ~/.config/hypr/monitors.conf           display modes (Display page)
  ~/.config/hyprdev/location             weather city
and applies changes live (hyprctl reload, eww relaunch, wallpaper restart).
Usage: hyprdev-settings [display|appearance|desktop|input|devices|system]
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
STATE = CFG / "hyprdev" / "settings.json"
HYPR_CONF = CFG / "hypr" / "hyprdev-settings.conf"
MONITORS_CONF = CFG / "hypr" / "monitors.conf"
LOCATION = CFG / "hyprdev" / "location"
WALL_LINK = CFG / "hypr" / "wallpaper"
WALL_DIRS = [Path("/usr/share/backgrounds/hyprdev"), HOME / "Pictures" / "Wallpapers"]
IMAGE_EXT = {".jpg", ".jpeg", ".png", ".webp"}

DEFAULTS = {
    "widgets": ["calendar", "clock", "info"],
    "gaps_in": 6,
    "gaps_out": 12,
    "rounding": 14,
    "blur": True,
    "animations": True,
    "kb_layout": "us",
    "natural_scroll": True,
    "tap_to_click": True,
    "sensitivity": 0.0,
}
WIDGETS = [("calendar", "Calendar strip"), ("clock", "Big clock"), ("info", "System info")]
SCALES = ["1", "1.25", "1.5", "1.75", "2", "0.75"]


# --------------------------------------------------------------------------- helpers
def run(cmd, wait=False):
    """Run a shell command; detached unless wait=True. Returns stdout when waiting."""
    if wait:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        return r.stdout
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return ""


def have(binary):
    return shutil.which(binary) is not None


def load_state():
    state = dict(DEFAULTS)
    try:
        state.update(json.loads(STATE.read_text()))
    except (OSError, ValueError):
        pass
    return state


def save_state(state):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(state, indent=2) + "\n")


def write_hypr_conf(s):
    HYPR_CONF.parent.mkdir(parents=True, exist_ok=True)
    b = lambda v: "true" if v else "false"  # noqa: E731
    HYPR_CONF.write_text(f"""# Generated by HyprDev Settings - changes here are overwritten.
# Put hand-written overrides in user.conf instead.
general {{
    gaps_in = {int(s['gaps_in'])}
    gaps_out = {int(s['gaps_out'])}
}}
decoration {{
    rounding = {int(s['rounding'])}
    blur {{
        enabled = {b(s['blur'])}
    }}
}}
animations {{
    enabled = {b(s['animations'])}
}}
input {{
    kb_layout = {s['kb_layout'].strip() or 'us'}
    sensitivity = {float(s['sensitivity']):.2f}
    touchpad {{
        natural_scroll = {b(s['natural_scroll'])}
        tap-to-click = {b(s['tap_to_click'])}
    }}
}}
""")


def hypr_reload():
    if have("hyprctl"):
        run("hyprctl reload", wait=True)


def monitors():
    if not have("hyprctl"):
        return []
    try:
        return json.loads(run("hyprctl -j monitors all", wait=True) or "[]")
    except ValueError:
        return []


def action_row(title, subtitle, icon, cmd, available=True):
    """A clickable row that launches cmd. Row titles are Pango markup (escape &)."""
    row = Adw.ActionRow(title=title, subtitle=subtitle if available else "Not installed")
    row.add_prefix(Gtk.Image.new_from_icon_name(icon))
    if available:
        row.set_activatable(True)
        row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        row.connect("activated", lambda *_: run(cmd))
    else:
        row.set_sensitive(False)
    return row


# --------------------------------------------------------------------------- pages
class Pages:
    def __init__(self, win, state):
        self.win = win
        self.s = state
        self._pending = None

    # Debounced apply for sliders/switches: write once the user stops changing.
    def changed(self, key, value, widgets=False):
        self.s[key] = value
        save_state(self.s)
        if self._pending:
            GLib.source_remove(self._pending)
        self._pending = GLib.timeout_add(350, self._apply, widgets)

    def _apply(self, widgets):
        self._pending = None
        write_hypr_conf(self.s)
        hypr_reload()
        if widgets:
            run("~/.config/eww/scripts/launch.sh")
        return False

    def toast(self, text):
        self.win.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    # ----- Display
    def display(self):
        page = Adw.PreferencesPage(title="Display", icon_name="video-display-symbolic")
        mons = monitors()
        if not mons:
            g = Adw.PreferencesGroup(title="Displays",
                                     description="No displays reported (is Hyprland running?).")
            page.add(g)
            return page
        self.mode_rows = []
        for m in mons:
            g = Adw.PreferencesGroup(
                title=m["name"],
                description=" ".join(x for x in (m.get("make"), m.get("model")) if x) or None)
            modes = []
            for mode in m.get("availableModes", []):
                mode = mode.removesuffix("Hz")
                if mode not in modes:
                    modes.append(mode)
            current = f"{m['width']}x{m['height']}@{m['refreshRate']:.2f}"
            if current not in modes:
                modes.insert(0, current)
            mode_row = Adw.ComboRow(title="Resolution", subtitle="Width × height @ refresh rate (Hz)",
                                    model=Gtk.StringList.new(modes))
            mode_row.set_selected(modes.index(current))
            scale_row = Adw.ComboRow(title="Scale", subtitle="Make everything bigger on high-DPI screens",
                                     model=Gtk.StringList.new(SCALES))
            cur_scale = f"{m.get('scale', 1):g}"
            scale_row.set_selected(SCALES.index(cur_scale) if cur_scale in SCALES else 0)
            g.add(mode_row)
            g.add(scale_row)
            self.mode_rows.append((m["name"], modes, mode_row, scale_row))
            page.add(g)

        g = Adw.PreferencesGroup()
        apply_row = Adw.ActionRow(title="Apply display settings",
                                  subtitle="Saved to ~/.config/hypr/monitors.conf")
        btn = Gtk.Button(label="Apply", valign=Gtk.Align.CENTER, css_classes=["suggested-action"])
        btn.connect("clicked", self.apply_displays)
        apply_row.add_suffix(btn)
        g.add(apply_row)
        reset_row = Adw.ActionRow(title="Automatic", subtitle="Let Hyprland pick the preferred mode for every display")
        rbtn = Gtk.Button(label="Reset", valign=Gtk.Align.CENTER)
        rbtn.connect("clicked", self.reset_displays)
        reset_row.add_suffix(rbtn)
        g.add(reset_row)
        g.add(action_row("Arrange displays", "Drag monitors into position (wdisplays)",
                         "preferences-desktop-display-symbolic", "wdisplays", have("wdisplays")))
        page.add(g)
        return page

    def apply_displays(self, *_):
        lines = ["# Written by HyprDev Settings (Display page)."]
        for name, modes, mode_row, scale_row in self.mode_rows:
            mode = modes[mode_row.get_selected()]
            scale = SCALES[scale_row.get_selected()]
            lines.append(f"monitor = {name}, {mode}, auto, {scale}")
        lines.append("monitor = , preferred, auto, auto   # any other display")
        MONITORS_CONF.write_text("\n".join(lines) + "\n")
        hypr_reload()
        self.toast("Display settings applied")

    def reset_displays(self, *_):
        MONITORS_CONF.write_text("# Auto-detect every display.\nmonitor = , preferred, auto, auto\n")
        hypr_reload()
        self.toast("Displays set to automatic")

    # ----- Appearance
    def appearance(self):
        page = Adw.PreferencesPage(title="Appearance", icon_name="preferences-desktop-wallpaper-symbolic")
        g = Adw.PreferencesGroup(title="Wallpaper",
                                 description="Add your own images to ~/Pictures/Wallpapers")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4,
                           min_children_per_line=2, row_spacing=10, column_spacing=10, homogeneous=True)
        current = WALL_LINK.resolve() if WALL_LINK.exists() else None
        for d in WALL_DIRS:
            if not d.is_dir():
                continue
            for f in sorted(d.iterdir()):
                if f.suffix.lower() not in IMAGE_EXT or f.name == "default.jpg":
                    continue
                pic = Gtk.Picture.new_for_filename(str(f))
                pic.set_content_fit(Gtk.ContentFit.COVER)
                pic.set_size_request(180, 101)
                btn = Gtk.Button(child=pic, tooltip_text=f.stem, css_classes=["card"])
                if current and f.resolve() == current:
                    btn.add_css_class("suggested-action")
                btn.connect("clicked", self.set_wallpaper, f)
                flow.append(btn)
        g.add(flow)
        page.add(g)

        g2 = Adw.PreferencesGroup(title="Theme")
        g2.add(action_row("Open wallpaper folder", "~/Pictures/Wallpapers", "folder-pictures-symbolic",
                          "mkdir -p ~/Pictures/Wallpapers && xdg-open ~/Pictures/Wallpapers"))
        g2.add(action_row("GTK theme, icons, cursor and fonts", "nwg-look",
                          "preferences-desktop-theme-symbolic", "nwg-look", have("nwg-look")))
        g2.add(action_row("Qt app style", "qt6ct", "preferences-desktop-theme-symbolic", "qt6ct", have("qt6ct")))
        page.add(g2)
        return page

    def set_wallpaper(self, btn, path):
        WALL_LINK.parent.mkdir(parents=True, exist_ok=True)
        if WALL_LINK.is_symlink() or WALL_LINK.exists():
            WALL_LINK.unlink()
        WALL_LINK.symlink_to(path)
        run("~/.config/hypr/scripts/wallpaper-daemon.sh")
        self.toast(f"Wallpaper: {path.stem}")

    # ----- Desktop
    def desktop(self):
        page = Adw.PreferencesPage(title="Desktop", icon_name="user-desktop-symbolic")
        g = Adw.PreferencesGroup(title="Widgets")
        for key, label in WIDGETS:
            sw = Adw.SwitchRow(title=label, active=key in self.s["widgets"])
            sw.connect("notify::active", self.toggle_widget, key)
            g.add(sw)
        city = Adw.EntryRow(title="Weather city (empty = detect from IP)", show_apply_button=True)
        try:
            city.set_text(LOCATION.read_text().strip())
        except OSError:
            pass
        city.connect("apply", self.set_city)
        g.add(city)
        page.add(g)

        g = Adw.PreferencesGroup(title="Windows")
        g.add(self.spin("Inner gaps", "Space between windows", "gaps_in", 0, 40))
        g.add(self.spin("Outer gaps", "Space around the screen edge", "gaps_out", 0, 60))
        g.add(self.spin("Corner rounding", "Window corner radius", "rounding", 0, 30))
        g.add(self.switch("Blur", "Frosted glass behind bars, menus and terminals", "blur"))
        g.add(self.switch("Animations", "Turn off for a snappier feel on slow GPUs", "animations"))
        page.add(g)
        return page

    def toggle_widget(self, sw, _pspec, key):
        w = [k for k, _ in WIDGETS if (k == key and sw.get_active()) or (k != key and k in self.s["widgets"])]
        self.changed("widgets", w, widgets=True)

    def set_city(self, row):
        text = row.get_text().strip()
        LOCATION.parent.mkdir(parents=True, exist_ok=True)
        if text:
            LOCATION.write_text(text + "\n")
        elif LOCATION.exists():
            LOCATION.unlink()
        run("~/.config/eww/scripts/weather.sh >/dev/null; ~/.config/eww/scripts/launch.sh")
        self.toast("Weather location saved")

    def spin(self, title, subtitle, key, lo, hi):
        row = Adw.SpinRow.new_with_range(lo, hi, 1)
        row.set_title(title)
        row.set_subtitle(subtitle)
        row.set_value(self.s[key])
        row.connect("notify::value", lambda r, _p: self.changed(key, int(r.get_value())))
        return row

    def switch(self, title, subtitle, key):
        row = Adw.SwitchRow(title=title, subtitle=subtitle, active=bool(self.s[key]))
        row.connect("notify::active", lambda r, _p: self.changed(key, r.get_active()))
        return row

    # ----- Input
    def input(self):
        page = Adw.PreferencesPage(title="Keyboard & mouse", icon_name="input-keyboard-symbolic")
        g = Adw.PreferencesGroup(title="Keyboard")
        kb = Adw.EntryRow(title="Layouts, comma separated (e.g. us,in)", show_apply_button=True)
        kb.set_text(self.s["kb_layout"])
        kb.connect("apply", lambda r: (self.changed("kb_layout", r.get_text()), self.toast("Keyboard layout applied")))
        g.add(kb)
        g.add(action_row("Keyboard shortcuts", "Every HyprDev key binding", "preferences-desktop-keyboard-shortcuts-symbolic",
                         "~/.config/hypr/scripts/keybinds.sh"))
        page.add(g)
        g = Adw.PreferencesGroup(title="Mouse &amp; touchpad")
        sens = Adw.SpinRow.new_with_range(-1, 1, 0.1)
        sens.set_title("Pointer speed")
        sens.set_subtitle("-1 slow … 1 fast")
        sens.set_digits(1)
        sens.set_value(self.s["sensitivity"])
        sens.connect("notify::value", lambda r, _p: self.changed("sensitivity", round(r.get_value(), 2)))
        g.add(sens)
        g.add(self.switch("Natural scrolling", "Touchpad content follows your fingers", "natural_scroll"))
        g.add(self.switch("Tap to click", "Tap the touchpad instead of pressing", "tap_to_click"))
        page.add(g)
        return page

    # ----- Devices
    def devices(self):
        page = Adw.PreferencesPage(title="Network & devices", icon_name="network-wireless-symbolic")
        g = Adw.PreferencesGroup()
        g.add(action_row("Wi-Fi &amp; network", "Connections, VPN, proxies", "network-wireless-symbolic",
                         "nm-connection-editor", have("nm-connection-editor")))
        g.add(action_row("Bluetooth", "Pair and manage devices", "bluetooth-symbolic",
                         "blueman-manager", have("blueman-manager")))
        g.add(action_row("Sound", "Outputs, inputs and per-app volume", "audio-speakers-symbolic",
                         "pavucontrol", have("pavucontrol")))
        g.add(action_row("Printers", "Add and configure printers", "printer-symbolic",
                         "system-config-printer", have("system-config-printer")))
        g.add(action_row("Phone (KDE Connect)", "Share files and notifications", "phone-symbolic",
                         "kdeconnect-app", have("kdeconnect-app")))
        page.add(g)
        return page

    # ----- System
    def system(self):
        page = Adw.PreferencesPage(title="System", icon_name="emblem-system-symbolic")
        g = Adw.PreferencesGroup(title="Software")
        g.add(action_row("Check for updates", "sudo dnf upgrade --refresh", "software-update-available-symbolic",
                         "kitty --title 'HyprDev updates' sh -c 'sudo dnf upgrade --refresh; echo; read -p \"Done - press Enter\" _'"))
        g.add(action_row("Apps &amp; developer tools", "Chrome, VSCode, runtimes, databases… (setup app)",
                         "system-software-install-symbolic", "kitty --title hyprdev-welcome hyprdev-welcome",
                         have("hyprdev-welcome")))
        page.add(g)
        g = Adw.PreferencesGroup(title="Reset")
        row = Adw.ActionRow(title="Restore default desktop settings",
                            subtitle="Changed files are backed up to ~/.config/hyprdev/backup-*")
        btn = Gtk.Button(label="Restore…", valign=Gtk.Align.CENTER, css_classes=["destructive-action"])
        btn.connect("clicked", self.confirm_reset)
        row.add_suffix(btn)
        g.add(row)
        page.add(g)
        g = Adw.PreferencesGroup(title="About")
        osr = {}
        try:
            for line in Path("/etc/os-release").read_text().splitlines():
                k, _, v = line.partition("=")
                osr[k] = v.strip('"')
        except OSError:
            pass
        info = [("System", osr.get("PRETTY_NAME", "HyprDev")),
                ("Kernel", os.uname().release),
                ("Hyprland", (run("hyprctl version 2>/dev/null | head -1", wait=True) or "-").strip())]
        for k, v in info:
            g.add(Adw.ActionRow(title=k, subtitle=v, subtitle_selectable=True))
        page.add(g)
        return page

    def confirm_reset(self, *_):
        d = Adw.AlertDialog(heading="Restore defaults?",
                            body="Your desktop config files go back to the HyprDev defaults. "
                                 "Changed files are backed up first; user.conf, your wallpaper and weather city are kept.")
        d.add_response("cancel", "Cancel")
        d.add_response("reset", "Restore")
        d.set_response_appearance("reset", Adw.ResponseAppearance.DESTRUCTIVE)
        d.connect("response", lambda _d, r: r == "reset" and (run("hyprdev-reset-config && hyprctl reload"),
                                                               self.toast("Defaults restored")))
        d.present(self.win)


# --------------------------------------------------------------------------- window
PAGES = [("display", "Display", "video-display-symbolic"),
         ("appearance", "Appearance", "preferences-desktop-wallpaper-symbolic"),
         ("desktop", "Desktop", "user-desktop-symbolic"),
         ("input", "Keyboard & mouse", "input-keyboard-symbolic"),
         ("devices", "Network & devices", "network-wireless-symbolic"),
         ("system", "System", "emblem-system-symbolic")]


class Window(Adw.ApplicationWindow):
    def __init__(self, app, start):
        super().__init__(application=app, title="HyprDev Settings", default_width=960, default_height=680)
        self.pages = Pages(self, load_state())
        self.toasts = Adw.ToastOverlay()

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        for key, _title, _icon in PAGES:
            self.stack.add_named(getattr(self.pages, key)(), key)

        listbox = Gtk.ListBox(css_classes=["navigation-sidebar"])
        for key, title, icon in PAGES:
            box = Gtk.Box(spacing=12, margin_top=8, margin_bottom=8, margin_start=6)
            box.append(Gtk.Image.new_from_icon_name(icon))
            box.append(Gtk.Label(label=title, xalign=0))
            row = Gtk.ListBoxRow(child=box)
            row.page = key
            listbox.append(row)
        listbox.connect("row-selected", lambda _lb, r: r and self.show_page(r.page))

        sidebar = Adw.ToolbarView()
        sidebar.add_top_bar(Adw.HeaderBar(title_widget=Adw.WindowTitle(title="HyprDev Settings")))
        sidebar.set_content(Gtk.ScrolledWindow(child=listbox))
        self.content_title = Adw.WindowTitle()
        content = Adw.ToolbarView()
        content.add_top_bar(Adw.HeaderBar(title_widget=self.content_title))
        content.set_content(self.stack)

        split = Adw.NavigationSplitView(
            sidebar=Adw.NavigationPage(title="HyprDev Settings", child=sidebar),
            content=Adw.NavigationPage(title="Settings", child=content))
        self.toasts.set_child(split)
        self.set_content(self.toasts)

        keys = [k for k, *_ in PAGES]
        listbox.select_row(listbox.get_row_at_index(keys.index(start) if start in keys else 0))

    def show_page(self, key):
        self.stack.set_visible_child_name(key)
        self.content_title.set_title(dict((k, t) for k, t, _ in PAGES)[key])


class App(Adw.Application):
    def __init__(self, start):
        super().__init__(application_id="dev.hyprdev.Settings", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.start = start

    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        Window(self, self.start).present()


if __name__ == "__main__":
    page = sys.argv[1] if len(sys.argv) > 1 else "display"
    sys.exit(App(page).run([sys.argv[0]]))
